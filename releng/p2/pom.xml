<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<artifactId>lsp4j.p2-repository</artifactId>
	<packaging>eclipse-repository</packaging>

	<parent>
		<groupId>org.eclipse.lsp4j</groupId>
		<artifactId>lsp4j-parent</artifactId>
		<version>1.1.0-SNAPSHOT</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>

	<dependencies>
		<!--
			The feature requires org.eclipse.xtend.lib (see feature.xml), it is resolved from
			Maven Central like for the generator bundle.
		-->
		<dependency>
			<groupId>org.eclipse.xtend</groupId>
			<artifactId>org.eclipse.xtend.lib</artifactId>
		</dependency>
	</dependencies>

	<properties>
		<!-- Only the bundles and the parent pom are published to Maven Central -->
		<maven.deploy.skip>true</maven.deploy.skip>
		<!--
			The root directory of the repository. It is used to copy the p2 repository, so
			that it can be picked up by releng/deploy-build.sh.
		-->
		<root-dir>${project.basedir}/../..</root-dir>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-p2-repository-plugin</artifactId>
				<version>${tycho-version}</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>assemble-repository</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>1.1</version>
				<executions>
					<execution>
						<phase>install</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<tasks>
								<!-- The p2 repository of an earlier build must not be deployed again -->
								<delete dir="${root-dir}/build/p2-repository" quiet="true" />
								<copy todir="${root-dir}/build/p2-repository">
									<fileset dir="${basedir}/target/repository/" />
								</copy>
								<copy
									file="${basedir}/target/lsp4j.p2-repository-1.1.0-SNAPSHOT.zip"
									tofile="${root-dir}/build/p2-repository/../lsp4j.p2-repository-1.1.0-SNAPSHOT.zip">
								</copy>
								<copy
									file="${basedir}/target/lsp4j.p2-repository-1.1.0-SNAPSHOT.zip"
									tofile="${root-dir}/build/p2-repository/v1.1.0.zip">
								</copy>
							</tasks>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
